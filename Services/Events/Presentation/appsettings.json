{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=events_db;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "SECRET_KEY_MINIMUM_32_CHARACTERS",
    "Issuer": "EventManagement",
    "Audience": "EventManagementClient",
    "ExpiryMinutes": 60
  },
  "Redis": {
    "ConnectionString": "redis:6379,password=,defaultDatabase=0,abortConnect=false",
    "InstanceName": "EventsCache",
    "CacheTTLSeconds": {
      "Event": 600,
      "Top10": 300
    }
  },
  "AllowedHosts": "*"
}